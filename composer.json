{
    "name": "leconfe/paypal-payment",
    "description": "PayPal payment gateway integration for Leconfe (Laravel 13 & Filament 5 compatible).",
    "autoload": {
        "psr-4": {
            "PaypalPayment\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Leconfe"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "omnipay/paypal": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
