{
    "name": "leconfe/paypal-payment",
    "description": "PayPal payment gateway integration for Leconfe.",
    "autoload": {
        "psr-4": {
            "PaypalPayment\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Leconfe"
        }
    ],
    "require": {
        "php": "^8.1",
        "omnipay/paypal": "^3.0"
    },
    "extra": {
        "leconfe": {
            "versions": ">=1.5 <1.7",
            "php": "^8.1",
            "laravel": "^10.0 || ^13.0",
            "filament": "^3.1 || ^5.0"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
